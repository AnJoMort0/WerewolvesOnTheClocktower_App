{
  "name": "werewolves-on-the-clocktower-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "dev:lan": "vite --config config/vite.config.ts --host 0.0.0.0",
    "lan": "node scripts/lan.mjs",
    "lan:prepare": "node scripts/build-lan.mjs",
    "lan:package": "node scripts/package-lan.mjs",
    "lan:release": "node scripts/release-lan.mjs",
    "build": "vite build --config config/vite.config.ts",
    "build:dev": "vite build --config config/vite.config.ts --mode development",
    "rulebook:build": "vite build --config config/vite.config.ts --mode rulebook",
    "rulebook:preview": "vite preview --config config/vite.config.ts --mode rulebook",
    "typecheck": "tsc -p config/tsconfig.app.json --noEmit && tsc -p config/tsconfig.node.json --noEmit",
    "lint": "eslint --config config/eslint.config.js .",
    "preview": "vite preview --config config/vite.config.ts",
    "preview:lan": "vite preview --config config/vite.config.ts --host 0.0.0.0",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:lan-browser": "node src/test/e2e/lan.smoke.mjs",
    "test:rulebook-browser": "node src/test/e2e/rulebook.smoke.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/crimson-text": "5.3.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.462.0",
    "mobile-drag-drop": "^3.0.0-rc.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "sharp": "0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
